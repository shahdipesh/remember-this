# Postgres (set automatically by the Vercel Postgres / Neon marketplace integration)
POSTGRES_URL=

# LLM: set at least one of these (OpenRouter takes precedence when several are set)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Shared secret protecting GET /api/messages (generate with: openssl rand -hex 32)
CRON_SECRET=

# Basic auth for the UI pages
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
